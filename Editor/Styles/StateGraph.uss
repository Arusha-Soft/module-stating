.stating-window { background-color: #202020; color: #c8c8c8; }
#graph-toolbar { height: 24px; flex-shrink: 0; background-color: #383838; }
#breadcrumbs { flex-direction: row; align-items: center; min-height: 27px; padding-left: 4px; background-color: #292929; border-bottom-width: 1px; border-bottom-color: #151515; }
#breadcrumbs Button { border-width: 0; background-color: #292929; margin: 0; padding-left: 9px; padding-right: 9px; }
#ownership-label { color: #999; font-size: 10px; margin-left: 16px; }
#left-panels { background-color: #2d2d2d; border-right-width: 1px; border-right-color: #111; }
#blackboard-panel, #inspector-panel, #history-panel { background-color: #2d2d2d; overflow: hidden; }
#panel-title { background-color: #3a3a3a; height: 27px; padding-left: 10px; padding-top: 5px; color: #bdbdbd; flex-shrink: 0; }
#blackboard-panel > IMGUIContainer, #history-panel > IMGUIContainer { padding: 5px; flex-grow: 1; }
#inspector-panel ScrollView { flex-grow: 1; padding: 6px; }
#state-graph { background-color: #202020; }
.stating-node { min-width: 225px; border-width: 1px; border-color: #111; }
.stating-node > #selection-border { border-radius: 5px; }
.stating-node #title { height: 32px; }
.stating-node #node-subtitle { color: #999; font-size: 10px; padding-left: 7px; padding-top: 3px; padding-bottom: 5px; }
.stating-node Foldout { margin-left: 0; margin-right: 0; border-top-width: 1px; border-top-color: #242424; }
.stating-node Foldout Button { font-size: 10px; -unity-text-align: middle-left; border-width: 0; background-color: #333; }
.stating-node #extension { background-color: #303030; padding: 4px; }
.stating-node #reference-label { color: #94c7d1; font-size: 10px; }
.runtime-active { border-width: 3px; border-color: #66dedc; }
.runtime-paused { border-color: #e5b957; }
.invalid-node { border-color: #d46a61; border-width: 2px; }
.runtime-transition { --edge-width: 5; }
.connection-execution { --edge-width: 3; }
.kind-entry, .kind-exit, .kind-anystate { min-width: 140px; }
.stating-note { min-width: 200px; }
.stating-note TextField { white-space: normal; flex-grow: 1; }
.stating-note .unity-text-input { background-color: rgba(0, 0, 0, 0); color: #e8e1c9; border-width: 0; }
#empty-state { flex-grow: 1; align-items: center; justify-content: center; }
#empty-state Label { margin: 8px; }
#empty-state Button { min-width: 230px; height: 32px; margin: 5px; }
